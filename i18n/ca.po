#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid ""
"The maximum time limit is 120 seconds (2 minutes).\n"
"Question: '%(question_title)s'\n"
"Please set a value between 3 and 120 seconds."
msgstr ""
"El límit de temps màxim és 120 segons (2 minuts).\n"
"Pregunta: '%(question_title)s'\n"
"Si us plau, estableixi un valor entre 3 i 120 segons."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid ""
"The maximum time limit is 120 seconds (2 minutes). It has been adjusted to "
"120."
msgstr ""
"El límit de temps màxim és 120 segons (2 minuts). S'ha ajustat a "
"120."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid ""
"The minimum time limit is 3 seconds.\n"
"Question: '%(question_title)s'\n"
"Please set 0 (no limit) or at least 3 seconds."
msgstr ""
"El límit de temps mínim és 3 segons.\n"
"Pregunta: '%(question_title)s'\n"
"Si us plau, estableixi 0 (sense límit) o almenys 3 segons."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid "The minimum time limit is 3 seconds. It has been set to 3 seconds."
msgstr "El límit de temps mínim és 3 segons. S'ha establert a 3 segons."

#. module: survey_question_timer
#: model:ir.model.fields,field_description:survey_question_timer.field_survey_question__time_limit
msgid "Time Limit (seconds)"
msgstr "Temps límit (segons)"

