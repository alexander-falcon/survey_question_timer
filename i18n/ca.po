#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid ""
"Questions with a time limit cannot be mandatory.\n"
"Question: '%(question_title)s'\n"
"Please remove the time limit or uncheck 'Mandatory answer'."
msgstr ""
"Les preguntes amb límit de temps no poden ser obligatòries.\n"
"Pregunta: '%(question_title)s'\n"
"Si us plau, elimini el límit de temps o desmarqui 'Resposta obligatòria'."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid ""
"Questions with a time limit cannot be mandatory. The time limit has been "
"removed."
msgstr ""
"Les preguntes amb límit de temps no poden ser obligatòries. El límit de "
"temps ha estat eliminat."

#. module: survey_question_timer
#: model:ir.model.fields,help:survey_question_timer.field_survey_question__time_limit
msgid ""
"Set a time limit in seconds for this question.\n"
"        - 0 means no time limit\n"
"        - Default: 10 seconds\n"
"        - Minimum: 3 seconds\n"
"        - Maximum: 120 seconds (2 minutes)\n"
"        - Only works when survey has: 'One page per question', 'Allow roaming' disabled, and no global time limit\n"
"        - Mandatory questions cannot have a time limit"
msgstr ""
"Estableix un temps límit en segons per a aquesta pregunta.\n"
"        - 0 significa sense límit de temps\n"
"        - Per defecte: 10 segons\n"
"        - Mínim: 3 segons\n"
"        - Màxim: 120 segons (2 minuts)\n"
"        - Només funciona amb: 'Una pregunta per pàgina', 'Permetre roaming' desactivat i sense límit de temps global\n"
"        - Les preguntes obligatòries no poden tenir límit de temps"

