#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid ""
"The maximum time limit is 120 seconds (2 minutes).\n"
"Question: '%(question_title)s'\n"
"Please set a value between 3 and 120 seconds."
msgstr ""
"El límite de tiempo máximo es 120 segundos (2 minutos).\n"
"Pregunta: '%(question_title)s'\n"
"Por favor, establezca un valor entre 3 y 120 segundos."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid ""
"The maximum time limit is 120 seconds (2 minutes). It has been adjusted to "
"120."
msgstr ""
"El límite de tiempo máximo es 120 segundos (2 minutos). Se ha ajustado a "
"120."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid ""
"The minimum time limit is 3 seconds.\n"
"Question: '%(question_title)s'\n"
"Please set 0 (no limit) or at least 3 seconds."
msgstr ""
"El límite de tiempo mínimo es 3 segundos.\n"
"Pregunta: '%(question_title)s'\n"
"Por favor, establezca 0 (sin límite) o al menos 3 segundos."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid "The minimum time limit is 3 seconds. It has been set to 3 seconds."
msgstr "El límite de tiempo mínimo es 3 segundos. Se ha establecido a 3 segundos."

#. module: survey_question_timer
