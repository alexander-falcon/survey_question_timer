#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid ""
"Questions with a time limit cannot be mandatory.\n"
"Question: '%(question_title)s'\n"
"Please remove the time limit or uncheck 'Mandatory answer'."
msgstr ""
"Las preguntas con límite de tiempo no pueden ser obligatorias.\n"
"Pregunta: '%(question_title)s'\n"
"Por favor, elimine el límite de tiempo o desmarque 'Respuesta obligatoria'."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey_question.py:0
#, python-format
msgid ""
"Questions with a time limit cannot be mandatory. The time limit has been "
"removed."
msgstr ""
"Las preguntas con límite de tiempo no pueden ser obligatorias. El límite de "
"tiempo ha sido eliminado."

#. module: survey_question_timer
#: model:ir.model.fields,help:survey_question_timer.field_survey_question__time_limit
msgid ""
"Set a time limit in seconds for this question.\n"
"        - 0 means no time limit\n"
"        - Default: 10 seconds\n"
"        - Minimum: 3 seconds\n"
"        - Maximum: 120 seconds (2 minutes)\n"
"        - Only works when survey has: 'One page per question', 'Allow roaming' disabled, and no global time limit\n"
"        - Mandatory questions cannot have a time limit"
msgstr ""
"Establece un tiempo límite en segundos para esta pregunta.\n"
"        - 0 significa sin límite de tiempo\n"
"        - Por defecto: 10 segundos\n"
"        - Mínimo: 3 segundos\n"
"        - Máximo: 120 segundos (2 minutos)\n"
"        - Solo funciona con: 'Una pregunta por página', 'Permitir roaming' desactivado y sin límite de tiempo global\n"
"        - Las preguntas obligatorias no pueden tener límite de tiempo"

#. module: survey_question_timer
