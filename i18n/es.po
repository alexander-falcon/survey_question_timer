#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey.py:0
#, python-format
msgid ""
"To use question time limits, ALL questions must have a time greater than 0 configured.\n"
"Please review the questions and assign a time to each one."
msgstr ""
"Para usar el límite de tiempo por pregunta, TODAS las preguntas deben tener "
"configurado un tiempo mayor que 0.\n"
"Por favor, revise las preguntas y asigne un tiempo a cada una."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey.py:0
#, python-format
msgid ""
"To use question time limits, pagination must be set to 'One page per question'.\n"
"Please change the 'Pagination' setting in the survey configuration."
msgstr ""
"Para usar el límite de tiempo por pregunta, la paginación debe ser 'Una pregunta por página'.\n"
"Por favor, cambie la configuración de 'Paginación' en la encuesta."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey.py:0
#, python-format
msgid ""
"To use question time limits, the global survey time limit must be disabled.\n"
"Please uncheck 'Time limit' in the survey configuration."
msgstr ""
"Para usar el límite de tiempo por pregunta, el límite de tiempo global debe estar desactivado.\n"
"Por favor, desmarque 'Límite de tiempo' en la encuesta."

#. module: survey_question_timer
#. odoo-python
#: code:addons/survey_question_timer/models/survey.py:0
#, python-format
msgid ""
"To use question time limits, users cannot go back to previous questions.\n"
"Please disable the 'Allow roaming' option in the survey configuration."
msgstr ""
"Para usar el límite de tiempo por pregunta, los usuarios no pueden volver atrás.\n"
"Por favor, desactive la opción 'Permitir roaming' en la encuesta."

#. module: survey_question_timer
#: model:ir.model.fields,field_description:survey_question_timer.field_survey_survey__use_question_time_limit
msgid "Use Question Time Limit"
msgstr "Usar límite de tiempo por pregunta"

#. module: survey_question_timer
